# Copier ce fichier en .env et remplir les valeurs (le .env n'est jamais commité)

# --- Base de données (PostgreSQL / Neon) ---
DATABASE_URL="postgresql://user:password@host:5432/database"

# --- Authentification ---
JWT_SECRET="une-cle-aleatoire-d-au-moins-32-caracteres"
JWT_EXPIRES_IN="7d"
CSRF_SECRET="une-autre-cle-aleatoire"

# --- Application ---
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:3001"
SUPPORT_EMAIL="contact@example.com"

# --- Comptes créés par le seed (npm run seed) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_TEST_EMAIL="test@example.com"
SEED_TEST_PASSWORD=""

# --- Email (Resend) ---
RESEND_API_KEY="re_..."

# --- Paiement des formules (DexPay, https://docs.dexpay.africa) ---
# Clés pk_test_/sk_test_ = paiements de test ; pk_live_/sk_live_ = vrais paiements.
DEXPAY_PUBLIC_KEY=""
DEXPAY_SECRET_KEY=""   # sert aussi à vérifier la signature des webhooks
DEXPAY_API_URL=""      # vide = https://api.dexpay.africa/api/v1
# URL publique de CETTE API, où DexPay envoie ses webhooks (POST <API_PUBLIC_URL>/api/dexpay/webhook).
# Recommandée en production : sans elle, la formule ne s'active qu'au retour sur la page de succès.
API_PUBLIC_URL=""      # ex. https://api.planora360.org
# Prix en FCFA entiers (facultatif, sinon grille tarifaire : 10 000 / 25 000 / 50 000 / 100 000 par mois)
# PRICE_INDIVIDUEL_MONTHLY=10000
# PRICE_INDIVIDUEL_YEARLY=100000
# PRICE_PRO_MONTHLY=25000
# PRICE_PRO_YEARLY=250000
# PRICE_EQUIPE_MONTHLY=50000
# PRICE_EQUIPE_YEARLY=500000
# PRICE_ORGANISATION_MONTHLY=100000
# PRICE_ORGANISATION_YEARLY=1000000

# --- Stockage des fichiers (Backblaze B2, sinon stockage local uploads/) ---
B2_KEY_ID=""
B2_APP_KEY=""
B2_BUCKET=""
B2_REGION=""
B2_ENDPOINT=""

# --- Suivi des erreurs (Sentry) ---
SENTRY_DSN_BACKEND=""
SENTRY_TRACES_SAMPLE_RATE="0.5"
SENTRY_PROFILES_SAMPLE_RATE="0.1"

# --- Analytics (PostHog) ---
POSTHOG_KEY=""
POSTHOG_HOST="https://eu.i.posthog.com"

# --- Cache Redis (optionnel, sinon cache mémoire) ---
REDIS_URL=""
