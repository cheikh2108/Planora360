# Copier ce fichier en .env et remplir les valeurs (le .env n'est jamais commité)

# --- Base de données (PostgreSQL / Neon) ---
DATABASE_URL="postgresql://user:password@host:5432/database"

# --- Authentification ---
JWT_SECRET="une-cle-aleatoire-d-au-moins-32-caracteres"
JWT_EXPIRES_IN="7d"
CSRF_SECRET="une-autre-cle-aleatoire"

# --- Application ---
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:3001"
SUPPORT_EMAIL="contact@example.com"

# --- Comptes créés par le seed (npm run seed) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_TEST_EMAIL="test@example.com"
SEED_TEST_PASSWORD=""

# --- Email (Resend) ---
RESEND_API_KEY="re_..."

# --- Paiement (DexPay) ---
DEXPAY_ENV="sandbox"
DEXPAY_API_URL=""
DEXPAY_PUBLIC_KEY=""
DEXPAY_SECRET_KEY=""
PLAN_INDIVIDUEL_MONTHLY=""
PLAN_INDIVIDUEL_YEARLY=""

# --- Stockage des fichiers (Backblaze B2, sinon stockage local uploads/) ---
B2_KEY_ID=""
B2_APP_KEY=""
B2_BUCKET=""
B2_REGION=""
B2_ENDPOINT=""

# --- Suivi des erreurs (Sentry) ---
SENTRY_DSN_BACKEND=""
SENTRY_TRACES_SAMPLE_RATE="0.5"
SENTRY_PROFILES_SAMPLE_RATE="0.1"

# --- Analytics (PostHog) ---
POSTHOG_KEY=""
POSTHOG_HOST="https://eu.i.posthog.com"

# --- Cache Redis (optionnel, sinon cache mémoire) ---
REDIS_URL=""
