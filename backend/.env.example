# Database
DATABASE_URL="postgresql://user:password@host:5432/database"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Frontend URL (pour CORS) - IMPORTANT !
# En production, mettre l'URL du frontend Hostinger
FRONTEND_URL="https://orangered-okapi-421028.hostingersite.com"

# Email (Resend)
RESEND_API_KEY="re_..."

# Port (optionnel, Hostinger le définit automatiquement)
PORT=3000

# Sentry (Error Tracking)
# Obtenez votre DSN sur: https://sentry.io/ (Free tier: 5K errors/month)
SENTRY_DSN_BACKEND="https://your-sentry-dsn@o123456.ingest.sentry.io/789012"
SENTRY_TRACES_SAMPLE_RATE="0.5"  # 50% des transactions (pour rester dans le free tier)
SENTRY_PROFILES_SAMPLE_RATE="0.1"  # 10% des profiles (optionnel)

# Redis Cache (optionnel mais recommandé pour production)
# Options gratuites recommandées:
# - Upstash: https://upstash.com/ (10K requêtes/jour gratuit)
# - Redis Cloud: https://redis.com/try-free/ (30MB gratuit)
# - Render Redis: https://render.com/docs/redis (256MB gratuit)
# Format: redis://username:password@host:port
# Exemple Upstash: redis://default:your-password@us1-merry-crab-12345.upstash.io:6379
REDIS_URL=""  # Si vide, utilise le cache mémoire (non persistant)
