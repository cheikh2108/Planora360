generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanStatus {
  BROUILLON
  EN_COURS
  TERMINE
  ARCHIVE
}

enum SubscriptionPlan {
  DECOUVERTE
  PROFESSIONNELLE
  SUR_MESURE
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum ActivityStatus {
  NON_DEMARREE
  EN_PREPARATION
  EN_COURS
  EN_ATTENTE
  SUSPENDUE
  TERMINEE
  VALIDEE
  EN_RETARD
  ANNULEE
}

enum ValidationStep {
  SOUMISSION
  VERIFICATION_HIERARCHIQUE
  VALIDATION_TECHNIQUE
  VALIDATION_ADMINISTRATIVE
  CLOTURE
}

enum ValidationDecision {
  APPROUVE
  REJETE
  EN_ATTENTE
}

model Organization {
  id               String             @id @default(cuid())
  name             String
  logoUrl          String?
  brandColor       String?            @default("#2563eb")
  subscriptionPlan SubscriptionPlan   @default(DECOUVERTE)
  status           OrganizationStatus @default(ACTIVE)
  rejectionReason  String?
  trialEndsAt      DateTime?
  createdAt        DateTime           @default(now())

  users                 User[]
  roles                 Role[]
  actionPlans           ActionPlan[]
  auditLogs             AuditLog[]
  participants          Participant[]
  capitalizationRecords CapitalizationRecord[]
  annualWorkPlans       AnnualWorkPlan[]
  resultsMatrix         ResultsMatrix?

  @@map("organizations")
}

model Role {
  id             String  @id @default(cuid())
  organizationId String?
  name           String
  permissions    Json

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model User {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleId          String
  role            Role         @relation(fields: [roleId], references: [id])
  email           String       @unique
  firstName       String
  lastName        String
  passwordHash    String
  twoFactorSecret String?
  isTwoFactorEnabled  Boolean   @default(false)
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  lastLoginAt         DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  refreshTokens           RefreshToken[]
  responsibleActivities   Activity[]             @relation("ActivityResponsible")
  checklistItems          ChecklistItem[]        @relation("ChecklistResponsible")
  collaboratingActivities ActivityCollaborator[] @relation("ActivityCollaborators")

  @@index([organizationId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model ActionPlan {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title              String
  status             PlanStatus @default(BROUILLON)
  periodStart        DateTime
  periodEnd          DateTime
  strategicGoals     String?
  expectedResults    String?
  budgetPrevisional  Decimal?     @db.Decimal(14, 2)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  axes Axis[]

  @@index([organizationId])
  @@map("action_plans")
}

model Axis {
  id           String     @id @default(cuid())
  actionPlanId String
  actionPlan   ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  title        String
  order        Int        @default(0)

  activities Activity[]

  @@map("axes")
}

model Activity {
  id               String         @id @default(cuid())
  organizationId   String
  axisId           String
  axis             Axis           @relation(fields: [axisId], references: [id], onDelete: Cascade)
  parentActivityId String?
  parent           Activity?      @relation("SubActivities", fields: [parentActivityId], references: [id])
  subActivities    Activity[]     @relation("SubActivities")
  title            String
  description      String?
  expectedResults  String?
  responsibleId    String
  responsible      User           @relation("ActivityResponsible", fields: [responsibleId], references: [id])
  startDate        DateTime
  dueDate          DateTime
  priority         String         @default("MOYENNE")
  budgetPlanned    Decimal?       @db.Decimal(14, 2)
  budgetExecuted   Decimal?       @db.Decimal(14, 2)
  status           ActivityStatus @default(NON_DEMARREE)
  completionRate   Float          @default(0)
  risks            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  checklistItems  ChecklistItem[]
  validations     Validation[]
  documents       Document[]
  budgets         Budget[]
  collaborators   ActivityCollaborator[]
  indicators      Indicator[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([axisId])
  @@map("activities")
}

model ActivityCollaborator {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("ActivityCollaborators", fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([activityId, userId])
  @@index([activityId])
  @@map("activity_collaborators")
}

model Indicator {
  id             String   @id @default(cuid())
  organizationId String
  activityId     String?
  activity       Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  title          String
  unit           String?
  baseline       Float    @default(0)
  target         Float
  achieved       Float    @default(0)
  dueDate        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([activityId])
  @@map("indicators")
}

model ChecklistItem {
  id            String    @id @default(cuid())
  activityId    String
  activity      Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  label         String
  responsibleId String
  responsible   User      @relation("ChecklistResponsible", fields: [responsibleId], references: [id])
  dueDate       DateTime?
  isMandatory   Boolean   @default(true)
  progress      Float     @default(0)
  observations  String?
  isValidated   Boolean   @default(false)
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  documents Document[]

  @@index([activityId])
  @@map("checklist_items")
}

model Validation {
  id          String             @id @default(cuid())
  activityId  String
  activity    Activity           @relation(fields: [activityId], references: [id])
  step        ValidationStep
  decision    ValidationDecision @default(EN_ATTENTE)
  validatorId String
  comment     String?
  createdAt   DateTime           @default(now())

  @@index([activityId])
  @@map("validations")
}

model Budget {
  id            String   @id @default(cuid())
  activityId    String
  activity      Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  planned       Decimal  @db.Decimal(14, 2)
  committed     Decimal  @db.Decimal(14, 2) @default(0)
  disbursed     Decimal  @db.Decimal(14, 2) @default(0)
  executed      Decimal  @db.Decimal(14, 2) @default(0)
  fundingSource String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([activityId])
  @@map("budgets")
}

model Document {
  id              String         @id @default(cuid())
  activityId      String?
  activity        Activity?      @relation(fields: [activityId], references: [id])
  checklistItemId String?
  checklistItem   ChecklistItem? @relation(fields: [checklistItemId], references: [id])
  type            String
  storageKey      String
  fileName        String
  fileSize        Int?
  mimeType        String?
  uploadedById    String
  createdAt       DateTime       @default(now())

  @@index([activityId])
  @@map("documents")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ==================== MODULES ADDITIONNELS ====================

// MODULE PARTICIPANTS
model Participant {
  id            String       @id @default(cuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activityId    String

  firstName     String
  lastName      String
  phone         String
  paymentMode   String       // "WAVE" | "ORANGE_MONEY"
  amount        Float

  createdBy     String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([phone, activityId])
  @@index([organizationId])
  @@index([activityId])
  @@map("participants")
}

// MODULE CAPITALISATION
model CapitalizationRecord {
  id            String       @id @default(cuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type          String       // "BONNE_PRATIQUE" | "RECIT_CHANGEMENT" | "GUIDE"
  title         String
  context       String       @db.Text
  challenges    String       @db.Text
  solutions     String       @db.Text
  results       String       @db.Text
  lessons       String       @db.Text

  tags          String[]
  status        String       @default("BROUILLON") // "BROUILLON" | "PUBLIE"

  authorId      String

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  media         Media[]

  @@index([organizationId])
  @@index([authorId])
  @@map("capitalization_records")
}

model Media {
  id                    String               @id @default(cuid())
  capitalizationId      String
  capitalization        CapitalizationRecord @relation(fields: [capitalizationId], references: [id], onDelete: Cascade)

  type                  String               // "PHOTO" | "VIDEO" | "DOCUMENT"
  filename              String
  url                   String               // Backblaze B2
  size                  Int

  uploadedAt            DateTime             @default(now())

  @@index([capitalizationId])
  @@map("media")
}

// MODULE PLANIFICATION
model AnnualWorkPlan {
  id            String       @id @default(cuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  year          Int
  title         String
  objectives    Json         // Structure flexible

  status        String       @default("BROUILLON") // "BROUILLON" | "VALIDE"
  validatedBy   String?
  validatedAt   DateTime?

  createdBy     String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([organizationId])
  @@index([year])
  @@map("annual_work_plans")
}

model ResultsMatrix {
  id            String       @id @default(cuid())
  organizationId String      @unique
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  data          Json         // Objectifs → Résultats → Indicateurs

  updatedAt     DateTime     @updatedAt

  @@map("results_matrices")
}
