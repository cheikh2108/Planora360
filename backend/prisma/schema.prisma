generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanStatus {
  BROUILLON
  EN_COURS
  TERMINE
  ARCHIVE
}

enum SubscriptionPlan {
  INDIVIDUEL
  PRO
  EQUIPE
  ORGANISATION
  ENTERPRISE
}

enum OrganizationStatus {
  PENDING
  PENDING_PAYMENT
  PENDING_VERIFICATION
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum ActivityStatus {
  NON_DEMARREE
  EN_PREPARATION
  EN_COURS
  EN_ATTENTE
  SUSPENDUE
  TERMINEE
  VALIDEE
  EN_RETARD
  ANNULEE
}

enum ValidationStep {
  SOUMISSION
  VERIFICATION_HIERARCHIQUE
  VALIDATION_TECHNIQUE
  VALIDATION_ADMINISTRATIVE
  CLOTURE
}

enum ValidationDecision {
  APPROUVE
  REJETE
  EN_ATTENTE
}

enum RecommendationSource {
  MISSION_SUPERVISION
  VISITE_TERRAIN
  AUDIT_INTERNE
  AUDIT_EXTERNE
  EVALUATION_PROJET
  EVALUATION_PROGRAMME
  REUNION_COORDINATION
  REVUE_PERFORMANCE
  CONTROLE_INTERNE
  CONTROLE_QUALITE
  REVUE_BUDGETAIRE
  REVUE_FINANCIERE
  OBSERVATION_BAILLEUR
  OBSERVATION_PARTENAIRE
  REVUE_GOUVERNANCE
  INSPECTION
  REVUE_DOCUMENTAIRE
  VERIFICATION_CONFORMITE
  AUTRE
}

enum RecommendationPriority {
  CRITIQUE
  ELEVEE
  MOYENNE
  FAIBLE
}

enum RecommendationStatus {
  NON_DEMARREE
  EN_COURS
  PARTIELLEMENT_MISE_EN_OEUVRE
  REALISEE_A_VALIDER
  EN_RETARD
  SUSPENDUE
  VALIDEE
  ROUVERTE
}

enum SecurityEventType {
  BRUTE_FORCE_LOGIN
  UNAUTHORIZED_ACCESS
  SUSPICIOUS_ACTIVITY
  ROLE_ESCALATION
  DATA_EXPORT
  FAILED_2FA
}

enum SecurityEventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SecurityEventStatus {
  DETECTED
  INVESTIGATING
  RESOLVED
  FALSE_POSITIVE
}

model Organization {
  id               String             @id @default(cuid())
  name             String
  logoUrl          String?
  brandColor       String?            @default("#2563eb")
  subscriptionPlan SubscriptionPlan   @default(INDIVIDUEL)
  status           OrganizationStatus @default(PENDING_PAYMENT)
  rejectionReason  String?
  trialEndsAt      DateTime?
  createdAt        DateTime           @default(now())
  deletedAt        DateTime?

  // DexPay - Paiement & Abonnement
  dexpayCustomerId     String?            @unique
  dexpaySubscriptionId String?            @unique
  subscriptionStatus   SubscriptionStatus @default(TRIAL)
  subscriptionCurrency String?            @default("XOF") // XOF, XAF, GNF
  billingCycle         BillingCycle       @default(MONTHLY)
  currentPeriodEnd     DateTime?
  nextPaymentDate      DateTime?

  // Vérification email
  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?   @unique
  emailVerificationExpiry  DateTime?

  users                 User[]
  roles                 Role[]
  actionPlans           ActionPlan[]
  auditLogs             AuditLog[]
  securityEvents        SecurityEvent[]
  participants          Participant[]
  capitalizationRecords CapitalizationRecord[]
  annualWorkPlans       AnnualWorkPlan[]
  resultsMatrix         ResultsMatrix?
  recommendations       Recommendation[]
  helpArticles          HelpArticle[]

  // Passation de marchés
  planPassationMarches PlanPassationMarche[]

  // Messagerie
  conversations Conversation[]

  // Zones géographiques
  geographicZones GeographicZone[]
  zoneConfig      OrganizationZoneConfig?

  // DexPay - Paiements
  payments        Payment[]

  @@map("organizations")
}

model Role {
  id             String  @id @default(cuid())
  organizationId String?
  name           String
  permissions    Json

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model User {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roleId             String
  role               Role         @relation(fields: [roleId], references: [id])
  // Unicité garantie par l'index partiel users_email_active_key (comptes non supprimés uniquement)
  email              String
  firstName          String
  lastName           String
  passwordHash       String
  twoFactorSecret    String?
  isTwoFactorEnabled Boolean      @default(false)
  isActive           Boolean      @default(true)
  mustChangePassword Boolean      @default(false)
  lastLoginAt        DateTime?
  // Date à laquelle l'utilisateur a marqué ses notifications comme lues (null = jamais)
  notificationsReadAt DateTime?
  // Préférences d'e-mails de notification (voir src/notifications/notification-preferences.ts)
  notificationPreferences Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  responsibleActivities   Activity[]             @relation("ActivityResponsible")
  checklistItems          ChecklistItem[]        @relation("ChecklistResponsible")
  collaboratingActivities ActivityCollaborator[] @relation("ActivityCollaborators")
  capitalizationRecords   CapitalizationRecord[] @relation("CapitalizationAuthor")

  recommendationsIssued       Recommendation[]            @relation("RecommendationIssuer")
  recommendationsResponsible  Recommendation[]            @relation("RecommendationResponsible")
  recommendationsValidated    Recommendation[]            @relation("RecommendationValidator")
  recommendationsCreated      Recommendation[]            @relation("RecommendationCreator")
  recommendationContributions RecommendationContributor[]
  recommendationActions       RecommendationAction[]
  recommendationEvidences     RecommendationEvidence[]
  recommendationComments      RecommendationComment[]
  auditLogs                   AuditLog[]                  @relation("AuditLogUser")
  recommendationHistory       RecommendationHistory[]
  sessions                    Session[]

  // Passation de marchés
  lignesPPMResponsable    LignePPM[]              @relation("LignePPMResponsable")
  demandesAchat           DemandeAchat[]          @relation("DemandeurAchat")
  validationsDemandes     ValidationDemande[]     @relation("ValidateurDemande")
  proceduresResponsable   Procedure[]             @relation("ProcedureResponsable")
  commissionsPresident    Commission[]            @relation("CommissionPresident")
  membresCommission       MembreCommission[]
  evaluations             Evaluation[]            @relation("Evaluateur")
  contratsGestionnaire    Contrat[]               @relation("ContratGestionnaire")
  livrablesResponsable    Livrable[]              @relation("LivrableResponsable")
  receptions              ReceptionLivrable[]     @relation("Receptionneur")
  evaluationsFournisseurs EvaluationFournisseur[] @relation("EvaluateurFournisseur")

  // Messagerie
  conversationsCreated     Conversation[]            @relation("ConversationCreator")
  conversationParticipants ConversationParticipant[] @relation("ConversationParticipant")
  messagesAuthored         Message[]                 @relation("MessageAuthor")
  messageReactions         MessageReaction[]         @relation("MessageReaction")
  messageReads             MessageRead[]             @relation("MessageRead")
  messageMentions          MessageMention[]          @relation("MessageMention")

  @@index([organizationId])
  @@map("users")
  // Jetons d'accès émis avant cette date refusés (déconnexion = révocation immédiate)
  tokensValidAfter   DateTime?
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// Lien « mot de passe oublié » : seul le hachage SHA-256 du jeton est stocké, à usage unique.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Device & Browser
  deviceName String?
  browser    String?
  os         String?

  // Location
  ipAddress String
  country   String?
  city      String?

  // Activity tracking
  lastActivityAt DateTime @default(now())
  expiresAt      DateTime

  // Metadata
  userAgent String?
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([lastActivityAt])
  @@map("sessions")
}

model ActionPlan {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title             String
  status            PlanStatus   @default(BROUILLON)
  periodStart       DateTime
  periodEnd         DateTime
  strategicGoals    String?
  expectedResults   String?
  budgetPrevisional Decimal?     @db.Decimal(14, 2)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  axes            Axis[]
  recommendations Recommendation[]

  // Passation de marchés
  planPassationMarches PlanPassationMarche[]

  // Messagerie (canaux projet)
  conversations Conversation[]

  // Zones géographiques d'intervention
  zones ActionPlanZone[]

  @@index([organizationId])
  @@map("action_plans")
}

model Axis {
  id           String     @id @default(cuid())
  actionPlanId String
  actionPlan   ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  title        String
  order        Int        @default(0)

  activities Activity[]

  @@map("axes")
}

model Activity {
  id               String         @id @default(cuid())
  organizationId   String
  axisId           String
  axis             Axis           @relation(fields: [axisId], references: [id], onDelete: Cascade)
  parentActivityId String?
  parent           Activity?      @relation("SubActivities", fields: [parentActivityId], references: [id])
  subActivities    Activity[]     @relation("SubActivities")
  title            String
  description      String?
  expectedResults  String?
  responsibleId    String
  responsible      User           @relation("ActivityResponsible", fields: [responsibleId], references: [id])
  startDate        DateTime
  dueDate          DateTime
  priority         String         @default("MOYENNE")
  budgetPlanned    Decimal?       @db.Decimal(14, 2)
  budgetExecuted   Decimal?       @db.Decimal(14, 2)
  status           ActivityStatus @default(NON_DEMARREE)
  completionRate   Float          @default(0)
  risks            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  checklistItems  ChecklistItem[]
  validations     Validation[]
  documents       Document[]
  budgets         Budget[]
  collaborators   ActivityCollaborator[]
  indicators      Indicator[]
  participants    Participant[]
  recommendations Recommendation[]

  // Passation de marchés
  lignesPPM     LignePPM[]
  demandesAchat DemandeAchat[]

  // Messagerie contextuelle
  conversations Conversation[]

  // Zones géographiques
  zones ActivityZone[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([axisId])
  @@map("activities")
}

model ActivityCollaborator {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("ActivityCollaborators", fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([activityId, userId])
  @@index([activityId])
  @@map("activity_collaborators")
}

model Indicator {
  id             String    @id @default(cuid())
  organizationId String
  activityId     String?
  activity       Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  title          String
  unit           String?
  baseline       Float     @default(0)
  target         Float
  achieved       Float     @default(0)
  dueDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([activityId])
  @@map("indicators")
}

model ChecklistItem {
  id            String    @id @default(cuid())
  activityId    String
  activity      Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  label         String
  responsibleId String
  responsible   User      @relation("ChecklistResponsible", fields: [responsibleId], references: [id])
  dueDate       DateTime?
  isMandatory   Boolean   @default(true)
  progress      Float     @default(0)
  observations  String?
  isValidated   Boolean   @default(false)
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  documents Document[]

  @@index([activityId])
  @@map("checklist_items")
}

model Validation {
  id          String             @id @default(cuid())
  activityId  String
  activity    Activity           @relation(fields: [activityId], references: [id], onDelete: Cascade)
  step        ValidationStep
  decision    ValidationDecision @default(EN_ATTENTE)
  validatorId String
  comment     String?
  createdAt   DateTime           @default(now())

  @@index([activityId])
  @@map("validations")
}

model Budget {
  id            String   @id @default(cuid())
  activityId    String
  activity      Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  planned       Decimal  @db.Decimal(14, 2)
  committed     Decimal  @default(0) @db.Decimal(14, 2)
  disbursed     Decimal  @default(0) @db.Decimal(14, 2)
  executed      Decimal  @default(0) @db.Decimal(14, 2)
  fundingSource String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([activityId])
  @@map("budgets")
}

model Document {
  id              String         @id @default(cuid())
  activityId      String?
  activity        Activity?      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  checklistItemId String?
  checklistItem   ChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  type            String
  storageKey      String
  fileName        String
  fileSize        Int?
  mimeType        String?
  uploadedById    String
  createdAt       DateTime       @default(now())

  @@index([activityId])
  @@map("documents")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("AuditLogUser", fields: [userId], references: [id], onDelete: Cascade)
  action         String
  entityType     String
  entityId       String
  metadata       Json?

  // Enhanced audit fields (Phase 3)
  ipAddress String?
  userAgent String?
  requestId String?
  oldValues Json?
  newValues Json?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([userId])
  @@index([requestId])
  @@map("audit_logs")
}

model SecurityEvent {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type     SecurityEventType
  severity SecurityEventSeverity
  status   SecurityEventStatus   @default(DETECTED)

  // Context
  userId    String?
  email     String?
  ipAddress String?
  userAgent String?

  // Details
  description String
  metadata    Json?

  // Resolution
  resolvedAt DateTime?
  resolvedBy String?
  resolution String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([ipAddress])
  @@map("security_events")
}

// ==================== MODULES ADDITIONNELS ====================

// MODULE PARTICIPANTS
model Participant {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activityId     String
  activity       Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  phone       String
  paymentMode String // "WAVE" | "ORANGE_MONEY"
  amount      Float

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([phone, activityId])
  @@index([organizationId])
  @@index([activityId])
  @@map("participants")
}

// MODULE CAPITALISATION
model CapitalizationRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type       String // "BONNE_PRATIQUE" | "RECIT_CHANGEMENT" | "GUIDE"
  title      String
  context    String @db.Text
  challenges String @db.Text
  solutions  String @db.Text
  results    String @db.Text
  lessons    String @db.Text

  tags   String[]
  status String   @default("BROUILLON") // "BROUILLON" | "PUBLIE"

  authorId String
  author   User   @relation("CapitalizationAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media Media[]

  @@index([organizationId])
  @@index([authorId])
  @@map("capitalization_records")
}

model Media {
  id               String               @id @default(cuid())
  capitalizationId String
  capitalization   CapitalizationRecord @relation(fields: [capitalizationId], references: [id], onDelete: Cascade)

  type     String // "PHOTO" | "VIDEO" | "DOCUMENT"
  filename String
  url      String // Backblaze B2
  size     Int

  uploadedAt DateTime @default(now())

  @@index([capitalizationId])
  @@map("media")
}

// MODULE RECOMMANDATIONS
model Recommendation {
  id   String @id @default(cuid())
  code String // unique par organisation (voir @@unique)

  // Identification
  title       String
  description String @db.Text

  // Source
  source            RecommendationSource
  sourceReference   String?
  sourceDocumentUrl String?

  // Rattachements
  actionPlanId   String?
  actionPlan     ActionPlan?  @relation(fields: [actionPlanId], references: [id])
  activityId     String?
  activity       Activity?    @relation(fields: [activityId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Dates
  issuedAt    DateTime
  dueDate     DateTime
  completedAt DateTime?
  validatedAt DateTime?

  // Acteurs
  issuerId       String?
  issuer         User?   @relation("RecommendationIssuer", fields: [issuerId], references: [id])
  issuerExternal String?

  responsibleId String
  responsible   User   @relation("RecommendationResponsible", fields: [responsibleId], references: [id])

  validatorId String?
  validator   User?   @relation("RecommendationValidator", fields: [validatorId], references: [id])

  createdById String
  createdBy   User   @relation("RecommendationCreator", fields: [createdById], references: [id])

  // Contributeurs
  contributors RecommendationContributor[]

  // Suivi
  priority RecommendationPriority
  status   RecommendationStatus   @default(NON_DEMARREE)
  progress Int                    @default(0)

  // Actions et preuves
  actions   RecommendationAction[]
  evidences RecommendationEvidence[]
  comments  RecommendationComment[]

  // Gestion des retards/suspensions
  suspendedReason String?   @db.Text
  suspendedAt     DateTime?
  suspendedBy     String?

  reopenedReason String?   @db.Text
  reopenedAt     DateTime?
  reopenedBy     String?

  // Historique
  history RecommendationHistory[]

  // Métadonnées
  isRecurrent    Boolean @default(false)
  recurrenceNote String? @db.Text

  // Messagerie contextuelle
  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([actionPlanId])
  @@index([activityId])
  @@index([responsibleId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([source])
  @@map("recommendations")

  @@unique([organizationId, code])
}

model RecommendationContributor {
  id               String         @id @default(cuid())
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  role             String?
  createdAt        DateTime       @default(now())

  @@unique([recommendationId, userId])
  @@index([recommendationId])
  @@index([userId])
  @@map("recommendation_contributors")
}

model RecommendationAction {
  id               String         @id @default(cuid())
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  title         String
  description   String?   @db.Text
  dueDate       DateTime?
  completedAt   DateTime?
  responsibleId String?
  responsible   User?     @relation(fields: [responsibleId], references: [id])

  status String @default("NON_DEMARREE")
  order  Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recommendationId])
  @@index([responsibleId])
  @@map("recommendation_actions")
}

model RecommendationEvidence {
  id               String         @id @default(cuid())
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  fileName    String
  fileUrl     String
  fileSize    Int
  mimeType    String
  description String?

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([recommendationId])
  @@index([uploadedById])
  @@map("recommendation_evidences")
}

model RecommendationComment {
  id               String         @id @default(cuid())
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  content     String  @db.Text
  isImportant Boolean @default(false)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recommendationId])
  @@index([authorId])
  @@map("recommendation_comments")
}

model RecommendationHistory {
  id               String         @id @default(cuid())
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  action   String
  field    String?
  oldValue String? @db.Text
  newValue String? @db.Text
  comment  String? @db.Text

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([recommendationId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("recommendation_history")
}

// MODULE HELP ARTICLES
model HelpArticle {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  page           String
  title          String
  content        String        @db.Text
  order          Int           @default(0)
  status         String        @default("DRAFT")
  authorId       String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([page])
  @@map("help_articles")
}

// MODULE PLANIFICATION
model AnnualWorkPlan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  year       Int
  title      String
  objectives Json // Structure flexible

  status      String    @default("BROUILLON") // "BROUILLON" | "VALIDE"
  validatedBy String?
  validatedAt DateTime?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([year])
  @@map("annual_work_plans")
}

model ResultsMatrix {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  data Json // Objectifs → Résultats → Indicateurs

  updatedAt DateTime @updatedAt

  @@map("results_matrices")
}

// SYSTÈME - MODE MAINTENANCE
model SystemSettings {
  id                 String    @id @default(cuid())
  maintenanceMode    Boolean   @default(false)
  maintenanceMessage String?   @db.Text
  scheduledStart     DateTime?
  scheduledEnd       DateTime?
  allowedIPs         String[]  @default([])
  allowedUserIds     String[]  @default([])
  updatedAt          DateTime  @updatedAt
  updatedBy          String? // userId du super admin qui a fait le changement

  @@map("system_settings")
}

// ==================== MODULE PASSATION DE MARCHÉS ====================

enum MethodeProcedure {
  ACHAT_DIRECT
  DEMANDE_COTATION
  CONSULTATION_RESTREINTE
  APPEL_OFFRES_OUVERT
  APPEL_OFFRES_RESTREINT
  DEMANDE_PROPOSITIONS
  MANIFESTATION_INTERET
  SELECTION_CONSULTANT
  PROCEDURE_URGENCE
  AUTRE
}

enum StatusPPM {
  BROUILLON
  VALIDE
  EN_COURS
  CLOTURE
}

enum StatusDemandeAchat {
  BROUILLON
  SOUMISE
  EN_VALIDATION
  APPROUVEE
  REJETEE
  ANNULEE
}

enum StatusProcedure {
  BROUILLON
  PUBLIEE
  EN_COURS
  CLOTUREE_OFFRES
  EVALUATION
  ATTRIBUEE
  INFRUCTUEUSE
  ANNULEE
}

enum StatusContrat {
  SIGNE
  EN_COURS
  SUSPENDU
  TERMINE
  CLOTURE
  RESILIE
}

enum StatusFournisseur {
  A_VALIDER
  ACTIF
  SUSPENDU
  BLACKLISTE
  ARCHIVE
}

// 1. Plan de Passation des Marchés
model PlanPassationMarche {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  reference String  // unique par organisation (voir @@unique)
  year      Int
  title     String
  projectId String?
  project   ActionPlan? @relation(fields: [projectId], references: [id])

  status      StatusPPM @default(BROUILLON)
  validatedBy String?
  validatedAt DateTime?

  montantTotal  Decimal @default(0) @db.Decimal(14, 2)
  nombreLignes  Int     @default(0)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lignes LignePPM[]

  @@index([organizationId])
  @@index([year])
  @@index([projectId])
  @@map("plan_passation_marches")

  @@unique([organizationId, reference])
}

model LignePPM {
  id    String              @id @default(cuid())
  ppmId String
  ppm   PlanPassationMarche @relation(fields: [ppmId], references: [id], onDelete: Cascade)

  reference String
  objet     String

  activityId String?
  activity   Activity? @relation(fields: [activityId], references: [id])

  montantEstimatif  Decimal @db.Decimal(14, 2)
  sourceFinancement String?
  ligneBudgetaire   String?

  methodeProcedure MethodeProcedure
  trimestre        Int // 1, 2, 3 ou 4 pour T1, T2, T3, T4
  observations     String?          @db.Text

  dateLancement   DateTime?
  dateAttribution DateTime?
  dateSignature   DateTime?
  dateExecution   DateTime?

  responsableId String
  responsable   User   @relation("LignePPMResponsable", fields: [responsableId], references: [id])

  status String @default("PREVISIONNEL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  demandeAchat DemandeAchat?
  procedure    Procedure?

  @@index([ppmId])
  @@index([activityId])
  @@index([responsableId])
  @@index([status])
  @@map("lignes_ppm")
}

// 2. Demandes d'achat
model DemandeAchat {
  id             String @id @default(cuid())
  organizationId String
  reference      String  // unique par organisation (voir @@unique)

  lignePPMId String?   @unique
  lignePPM   LignePPM? @relation(fields: [lignePPMId], references: [id])
  activityId String?
  activity   Activity? @relation(fields: [activityId], references: [id])

  objet          String
  description    String  @db.Text
  justification  String  @db.Text
  quantite       Float?
  specifications String? @db.Text

  montantEstimatif  Decimal @db.Decimal(14, 2)
  ligneBudgetaire   String?
  sourceFinancement String?

  echeanceSouhaitee DateTime?

  status StatusDemandeAchat @default(BROUILLON)

  demandeurId String
  demandeur   User   @relation("DemandeurAchat", fields: [demandeurId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  validations ValidationDemande[]
  procedure   Procedure?

  @@index([organizationId])
  @@index([activityId])
  @@index([demandeurId])
  @@index([status])
  @@map("demandes_achat")

  @@unique([organizationId, reference])
}

model ValidationDemande {
  id        String       @id @default(cuid())
  demandeId String
  demande   DemandeAchat @relation(fields: [demandeId], references: [id], onDelete: Cascade)

  etape String
  ordre Int

  validateurId String
  validateur   User   @relation("ValidateurDemande", fields: [validateurId], references: [id])

  decision    String  @default("EN_ATTENTE")
  commentaire String? @db.Text

  validatedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([demandeId])
  @@index([validateurId])
  @@map("validations_demande")
}

// 3. Fournisseurs
model Fournisseur {
  id             String @id @default(cuid())
  organizationId String

  raisonSociale     String
  identifiantFiscal String?
  registreCommerce  String?

  adresse   String?
  ville     String?
  pays      String  @default("Sénégal")
  telephone String?
  email     String?
  siteWeb   String?

  nomContact       String?
  prenomContact    String?
  fonctionContact  String?
  telephoneContact String?
  emailContact     String?

  domainesActivite  String[]
  categoriesBiens   String[]
  zonesIntervention String[]

  status StatusFournisseur @default(A_VALIDER)
  // Motif de la dernière suspension / mise sur liste noire
  motifStatut String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents   FournisseurDocument[]
  soumissions Soumission[]
  contrats    Contrat[]
  evaluations EvaluationFournisseur[]

  @@index([organizationId])
  @@index([status])
  @@map("fournisseurs")
}

model FournisseurDocument {
  id            String      @id @default(cuid())
  fournisseurId String
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)

  type     String
  nom      String
  url      String
  fileSize Int?
  mimeType String?

  dateExpiration DateTime?

  uploadedAt DateTime @default(now())

  @@index([fournisseurId])
  @@map("fournisseur_documents")
}

// 4. Procédures
model Procedure {
  id             String @id @default(cuid())
  organizationId String
  reference      String  // unique par organisation (voir @@unique)

  demandeAchatId String?       @unique
  demandeAchat   DemandeAchat? @relation(fields: [demandeAchatId], references: [id])
  lignePPMId     String?       @unique
  lignePPM       LignePPM?     @relation(fields: [lignePPMId], references: [id])

  methode     MethodeProcedure
  objet       String
  description String           @db.Text

  montantEstimatif Decimal @db.Decimal(14, 2)

  datePublication   DateTime?
  dateLimite        DateTime?
  dateOuverture     DateTime?
  dateClarification DateTime?
  dateAttribution   DateTime?

  responsableId String
  responsable   User   @relation("ProcedureResponsable", fields: [responsableId], references: [id])

  status StatusProcedure @default(BROUILLON)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents     DossierConsultation[]
  soumissions   Soumission[]
  commissions   Commission[]
  contrat       Contrat?
  conversations Conversation[]

  @@index([organizationId])
  @@index([responsableId])
  @@index([status])
  @@map("procedures")

  @@unique([organizationId, reference])
}

model DossierConsultation {
  id          String    @id @default(cuid())
  procedureId String
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  type    String
  titre   String
  version String @default("1.0")

  documentUrl String
  fileName    String
  fileSize    Int?

  uploadedBy String
  uploadedAt DateTime @default(now())

  @@index([procedureId])
  @@map("dossier_consultation")
}

// 5. Soumissions et évaluation
model Soumission {
  id          String    @id @default(cuid())
  procedureId String
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  numeroDepot String  // unique par procédure (voir @@unique)

  fournisseurId String
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id])

  montantTechnique Decimal? @db.Decimal(14, 2)
  montantFinancier Decimal  @db.Decimal(14, 2)
  montantTotal     Decimal  @db.Decimal(14, 2)
  devise           String   @default("XOF")

  conformeAdmin     Boolean?
  conformeTechnique Boolean?
  conformeFinancier Boolean?

  dateDepot DateTime @default(now())
  horsDelai Boolean  @default(false)

  status String @default("DEPOSEE")

  documents   SoumissionDocument[]
  evaluations Evaluation[]
  contrat     Contrat?

  @@index([procedureId])
  @@index([fournisseurId])
  @@index([status])
  @@map("soumissions")

  @@unique([procedureId, numeroDepot])
}

model SoumissionDocument {
  id           String     @id @default(cuid())
  soumissionId String
  soumission   Soumission @relation(fields: [soumissionId], references: [id], onDelete: Cascade)

  type     String
  nom      String
  url      String
  fileSize Int?

  uploadedAt DateTime @default(now())

  @@index([soumissionId])
  @@map("soumission_documents")
}

model Commission {
  id          String    @id @default(cuid())
  procedureId String
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  nom        String
  type       String
  dateSeance DateTime

  presidentId String
  president   User   @relation("CommissionPresident", fields: [presidentId], references: [id])

  createdAt DateTime @default(now())

  membres     MembreCommission[]
  evaluations Evaluation[]

  @@index([procedureId])
  @@map("commissions")
}

model MembreCommission {
  id           String     @id @default(cuid())
  commissionId String
  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  role String

  @@unique([commissionId, userId])
  @@index([commissionId])
  @@map("membres_commission")
}

model Evaluation {
  id           String     @id @default(cuid())
  soumissionId String
  soumission   Soumission @relation(fields: [soumissionId], references: [id], onDelete: Cascade)

  commissionId String
  commission   Commission @relation(fields: [commissionId], references: [id])

  evaluateurId String
  evaluateur   User   @relation("Evaluateur", fields: [evaluateurId], references: [id])

  scoreAdmin     Float?
  scoreTechnique Float?
  scoreFinancier Float?
  scoreGlobal    Float?

  criteres     Json
  commentaires String? @db.Text

  validatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([soumissionId, evaluateurId])
  @@index([soumissionId])
  @@index([commissionId])
  @@map("evaluations")
}

// 6. Contrats
model Contrat {
  id             String @id @default(cuid())
  organizationId String
  reference      String  // unique par organisation (voir @@unique)

  procedureId String    @unique
  procedure   Procedure @relation(fields: [procedureId], references: [id])

  soumissionId String?     @unique
  soumission   Soumission? @relation(fields: [soumissionId], references: [id])

  fournisseurId String
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id])

  montantInitial Decimal  @db.Decimal(14, 2)
  montantRevise  Decimal? @db.Decimal(14, 2)
  montantPaye    Decimal  @default(0) @db.Decimal(14, 2)
  devise         String   @default("XOF")

  dateSignature     DateTime
  dateDemarrage     DateTime?
  dateEcheance      DateTime
  dateReceptionProv DateTime?
  dateReceptionDef  DateTime?

  modalitesAvance  String? @db.Text
  modalitesAcompte String? @db.Text
  modalitesRetenue String? @db.Text
  garanties        String? @db.Text

  gestionnaire     String
  gestionnaireUser User   @relation("ContratGestionnaire", fields: [gestionnaire], references: [id])

  status StatusContrat @default(SIGNE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  avenants      Avenant[]
  livrables     Livrable[]
  paiements     PaiementContrat[]
  conversations Conversation[]

  @@index([organizationId])
  @@index([fournisseurId])
  @@index([gestionnaire])
  @@index([status])
  @@map("contrats")

  @@unique([organizationId, reference])
}

model Avenant {
  id        String  @id @default(cuid())
  contratId String
  contrat   Contrat @relation(fields: [contratId], references: [id], onDelete: Cascade)

  numero Int
  motif  String @db.Text

  impactMontant Decimal? @db.Decimal(14, 2)
  impactDelai   Int?
  impactObjet   String?  @db.Text

  dateSignature DateTime

  validatedBy String?
  validatedAt DateTime?

  status String @default("BROUILLON")

  createdAt DateTime @default(now())

  @@index([contratId])
  @@map("avenants")
}

model Livrable {
  id        String  @id @default(cuid())
  contratId String
  contrat   Contrat @relation(fields: [contratId], references: [id], onDelete: Cascade)

  titre       String
  description String? @db.Text

  dateEcheance DateTime

  responsableId String?
  responsable   User?   @relation("LivrableResponsable", fields: [responsableId], references: [id])

  status String @default("EN_ATTENTE")

  ordre Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receptions ReceptionLivrable[]

  @@index([contratId])
  @@map("livrables")
}

model ReceptionLivrable {
  id         String   @id @default(cuid())
  livrableId String
  livrable   Livrable @relation(fields: [livrableId], references: [id], onDelete: Cascade)

  type String

  quantitePrevue Float?
  quantiteRecue  Float?

  conforme Boolean @default(true)
  reserves String? @db.Text

  dateReception DateTime

  receptionneurId String
  receptionneur   User   @relation("Receptionneur", fields: [receptionneurId], references: [id])

  pvUrl String?

  createdAt DateTime @default(now())

  @@index([livrableId])
  @@map("receptions_livrable")
}

model PaiementContrat {
  id        String  @id @default(cuid())
  contratId String
  contrat   Contrat @relation(fields: [contratId], references: [id], onDelete: Cascade)

  type String

  montantBrut Decimal @db.Decimal(14, 2)
  taxes       Decimal @default(0) @db.Decimal(14, 2)
  penalites   Decimal @default(0) @db.Decimal(14, 2)
  montantNet  Decimal @db.Decimal(14, 2)

  dateEcheance DateTime?
  datePaiement DateTime?

  status String @default("EN_ATTENTE")

  referenceComptable String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contratId])
  @@index([status])
  @@map("paiements_contrat")
}

model EvaluationFournisseur {
  id            String      @id @default(cuid())
  fournisseurId String
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)

  contratId String?

  qualite            Float?
  delais             Float?
  conformite         Float?
  disponibilite      Float?
  serviceAV          Float?
  respectContractuel Float?
  rapportQualitePrix Float?

  noteGlobale  Float
  commentaires String? @db.Text

  evaluateurId String
  evaluateur   User   @relation("EvaluateurFournisseur", fields: [evaluateurId], references: [id])

  createdAt DateTime @default(now())

  @@index([fournisseurId])
  @@map("evaluations_fournisseur")
}

// ==================== MODULE MESSAGERIE ====================

enum ConversationType {
  DIRECT
  GROUP
  CHANNEL_PROJECT
  CHANNEL_TEAM
  CONTEXTUAL
}

enum ConversationRole {
  ADMIN
  MEMBER
  OBSERVER
}

enum MessageContentType {
  TEXT
  HTML
  MARKDOWN
}

enum MentionType {
  USER
  TEAM
  EVERYONE
}

model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type ConversationType

  name        String?
  description String? @db.Text
  avatarUrl   String?

  projectId String?
  project   ActionPlan? @relation(fields: [projectId], references: [id])

  activityId String?
  activity   Activity? @relation(fields: [activityId], references: [id])

  recommendationId String?
  recommendation   Recommendation? @relation(fields: [recommendationId], references: [id])

  procedureId String?
  procedure   Procedure? @relation(fields: [procedureId], references: [id])

  contratId String?
  contrat   Contrat? @relation(fields: [contratId], references: [id])

  isArchived    Boolean   @default(false)
  lastMessageAt DateTime?

  createdById String
  createdBy   User   @relation("ConversationCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([organizationId])
  @@index([type])
  @@index([projectId])
  @@index([activityId])
  @@index([recommendationId])
  @@index([procedureId])
  @@index([contratId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ConversationParticipant", fields: [userId], references: [id], onDelete: Cascade)

  role ConversationRole @default(MEMBER)

  isMuted  Boolean @default(false)
  isPinned Boolean @default(false)

  lastReadAt  DateTime?
  unreadCount Int       @default(0)

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@index([isPinned])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("MessageAuthor", fields: [authorId], references: [id])

  content     String             @db.Text
  contentType MessageContentType @default(TEXT)

  parentId String?
  parent   Message?  @relation("MessageThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Message[] @relation("MessageThread")

  isEdited  Boolean   @default(false)
  editedAt  DateTime?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  isSystem Boolean @default(false)

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments MessageAttachment[]
  reactions   MessageReaction[]
  reads       MessageRead[]
  mentions    MessageMention[]

  @@index([conversationId])
  @@index([authorId])
  @@index([parentId])
  @@index([createdAt])
  @@index([isDeleted])
  @@map("messages")
}

model MessageAttachment {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileName String
  fileUrl  String
  fileSize Int
  mimeType String

  thumbnailUrl String?
  width        Int?
  height       Int?
  duration     Int?

  uploadedAt DateTime @default(now())

  @@index([messageId])
  @@map("message_attachments")
}

model MessageReaction {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("MessageReaction", fields: [userId], references: [id], onDelete: Cascade)

  emoji String

  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
  @@map("message_reactions")
}

model MessageRead {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("MessageRead", fields: [userId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("message_reads")
}

model MessageMention {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("MessageMention", fields: [userId], references: [id], onDelete: Cascade)

  type MentionType @default(USER)

  startPos Int?
  endPos   Int?

  notified Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([userId])
  @@index([notified])
  @@map("message_mentions")
}

// ==================== MODULE ZONES GÉOGRAPHIQUES ====================

model GeographicZone {
  id             String   @id @default(cuid())
  name           String
  code           String?
  level          Int      @default(0) // 0=pays, 1=région, 2=département, 3=arrondissement, etc.
  description    String?  @db.Text

  // Hiérarchie
  parentId       String?
  parent         GeographicZone?  @relation("ZoneHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children       GeographicZone[] @relation("ZoneHierarchy")

  // Métadonnées géographiques (optionnel pour Phase 2)
  latitude       Float?
  longitude      Float?
  polygon        Json?    // GeoJSON pour les contours

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  activities     ActivityZone[]
  actionPlans    ActionPlanZone[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([parentId])
  @@index([level])
  @@map("geographic_zones")
}

model ActivityZone {
  id         String   @id @default(cuid())

  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  zoneId     String
  zone       GeographicZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  isPrimary  Boolean  @default(true)

  createdAt  DateTime @default(now())

  @@unique([activityId, zoneId])
  @@index([activityId])
  @@index([zoneId])
  @@map("activity_zones")
}

model ActionPlanZone {
  id           String     @id @default(cuid())

  actionPlanId String
  actionPlan   ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)

  zoneId       String
  zone         GeographicZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@unique([actionPlanId, zoneId])
  @@index([actionPlanId])
  @@index([zoneId])
  @@map("action_plan_zones")
}

// Configuration des niveaux géographiques par organisation
model OrganizationZoneConfig {
  id             String   @id @default(cuid())
  organizationId String   @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Preset: SANTE, STANDARD, CUSTOM
  preset         String   @default("STANDARD")

  // Configuration des labels par niveau (JSON)
  // Exemple: {"0": "Pays", "1": "Région", "2": "District", "3": "Structure"}
  levelLabels    Json     @default("{\"0\":\"Pays\",\"1\":\"Région\",\"2\":\"Département\",\"3\":\"Commune\"}")

  // Description de la configuration
  description    String?  @db.Text

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@map("organization_zone_configs")
}

// DexPay - Historique des paiements
model Payment {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // DexPay checkout session
  dexpayReference   String   @unique  // reference de la checkout session
  dexpayCheckoutId  String?  @unique  // ID de la checkout session

  // Informations paiement
  amount          Int      // montant entier dans la devise (10000 = 10 000 XOF) : DexPay n'utilise pas de centimes
  currency        String   // XOF, XAF, GNF
  status          String   // pending, completed, failed, cancelled, refunded
  paymentMethod   String?  // wave, orange_money, mtn_money, etc.

  // Plan acheté
  plan            SubscriptionPlan
  periodStart     DateTime?
  periodEnd       DateTime?

  // Métadonnées
  metadata        Json?    // infos supplémentaires du paiement

  createdAt       DateTime @default(now())
  paidAt          DateTime?

  @@index([organizationId])
  @@index([status])
  @@map("payments")
}
