generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanStatus {
  BROUILLON
  EN_COURS
  TERMINE
  ARCHIVE
}

enum SubscriptionPlan {
  DECOUVERTE
  PROFESSIONNELLE
  SUR_MESURE
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum ActivityStatus {
  NON_DEMARREE
  EN_PREPARATION
  EN_COURS
  EN_ATTENTE
  SUSPENDUE
  TERMINEE
  VALIDEE
  EN_RETARD
  ANNULEE
}

enum ValidationStep {
  SOUMISSION
  VERIFICATION_HIERARCHIQUE
  VALIDATION_TECHNIQUE
  VALIDATION_ADMINISTRATIVE
  CLOTURE
}

enum ValidationDecision {
  APPROUVE
  REJETE
  EN_ATTENTE
}

enum RecommendationSource {
  MISSION_SUPERVISION
  VISITE_TERRAIN
  AUDIT_INTERNE
  AUDIT_EXTERNE
  EVALUATION_PROJET
  EVALUATION_PROGRAMME
  REUNION_COORDINATION
  REVUE_PERFORMANCE
  CONTROLE_INTERNE
  CONTROLE_QUALITE
  REVUE_BUDGETAIRE
  REVUE_FINANCIERE
  OBSERVATION_BAILLEUR
  OBSERVATION_PARTENAIRE
  REVUE_GOUVERNANCE
  INSPECTION
  REVUE_DOCUMENTAIRE
  VERIFICATION_CONFORMITE
  AUTRE
}

enum RecommendationPriority {
  CRITIQUE
  ELEVEE
  MOYENNE
  FAIBLE
}

enum RecommendationStatus {
  NON_DEMARREE
  EN_COURS
  PARTIELLEMENT_MISE_EN_OEUVRE
  REALISEE_A_VALIDER
  EN_RETARD
  SUSPENDUE
  VALIDEE
  ROUVERTE
}

model Organization {
  id               String             @id @default(cuid())
  name             String
  logoUrl          String?
  brandColor       String?            @default("#2563eb")
  subscriptionPlan SubscriptionPlan   @default(DECOUVERTE)
  status           OrganizationStatus @default(ACTIVE)
  rejectionReason  String?
  trialEndsAt      DateTime?
  createdAt        DateTime           @default(now())

  users                 User[]
  roles                 Role[]
  actionPlans           ActionPlan[]
  auditLogs             AuditLog[]
  participants          Participant[]
  capitalizationRecords CapitalizationRecord[]
  annualWorkPlans       AnnualWorkPlan[]
  resultsMatrix         ResultsMatrix?
  recommendations       Recommendation[]
  helpArticles          HelpArticle[]

  @@map("organizations")
}

model Role {
  id             String  @id @default(cuid())
  organizationId String?
  name           String
  permissions    Json

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model User {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roleId             String
  role               Role         @relation(fields: [roleId], references: [id])
  email              String       @unique
  firstName          String
  lastName           String
  passwordHash       String
  twoFactorSecret    String?
  isTwoFactorEnabled Boolean      @default(false)
  isActive           Boolean      @default(true)
  mustChangePassword Boolean      @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  refreshTokens           RefreshToken[]
  responsibleActivities   Activity[]             @relation("ActivityResponsible")
  checklistItems          ChecklistItem[]        @relation("ChecklistResponsible")
  collaboratingActivities ActivityCollaborator[] @relation("ActivityCollaborators")
  capitalizationRecords   CapitalizationRecord[] @relation("CapitalizationAuthor")

  recommendationsIssued       Recommendation[]            @relation("RecommendationIssuer")
  recommendationsResponsible  Recommendation[]            @relation("RecommendationResponsible")
  recommendationsValidated    Recommendation[]            @relation("RecommendationValidator")
  recommendationsCreated      Recommendation[]            @relation("RecommendationCreator")
  recommendationContributions RecommendationContributor[]
  recommendationActions       RecommendationAction[]
  recommendationEvidences     RecommendationEvidence[]
  recommendationComments      RecommendationComment[]
  auditLogs                   AuditLog[]                  @relation("AuditLogUser")
  recommendationHistory       RecommendationHistory[]

  @@index([organizationId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model ActionPlan {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title             String
  status            PlanStatus   @default(BROUILLON)
  periodStart       DateTime
  periodEnd         DateTime
  strategicGoals    String?
  expectedResults   String?
  budgetPrevisional Decimal?     @db.Decimal(14, 2)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  axes            Axis[]
  recommendations Recommendation[]

  @@index([organizationId])
  @@map("action_plans")
}

model Axis {
  id           String     @id @default(cuid())
  actionPlanId String
  actionPlan   ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  title        String
  order        Int        @default(0)

  activities Activity[]

  @@map("axes")
}

model Activity {
  id               String         @id @default(cuid())
  organizationId   String
  axisId           String
  axis             Axis           @relation(fields: [axisId], references: [id], onDelete: Cascade)
  parentActivityId String?
  parent           Activity?      @relation("SubActivities", fields: [parentActivityId], references: [id])
  subActivities    Activity[]     @relation("SubActivities")
  title            String
  description      String?
  expectedResults  String?
  responsibleId    String
  responsible      User           @relation("ActivityResponsible", fields: [responsibleId], references: [id])
  startDate        DateTime
  dueDate          DateTime
  priority         String         @default("MOYENNE")
  budgetPlanned    Decimal?       @db.Decimal(14, 2)
  budgetExecuted   Decimal?       @db.Decimal(14, 2)
  status           ActivityStatus @default(NON_DEMARREE)
  completionRate   Float          @default(0)
  risks            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  checklistItems  ChecklistItem[]
  validations     Validation[]
  documents       Document[]
  budgets         Budget[]
  collaborators   ActivityCollaborator[]
  indicators      Indicator[]
  participants    Participant[]
  recommendations Recommendation[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([axisId])
  @@map("activities")
}

model ActivityCollaborator {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("ActivityCollaborators", fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([activityId, userId])
  @@index([activityId])
  @@map("activity_collaborators")
}

model Indicator {
  id             String    @id @default(cuid())
  organizationId String
  activityId     String?
  activity       Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  title          String
  unit           String?
  baseline       Float     @default(0)
  target         Float
  achieved       Float     @default(0)
  dueDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([activityId])
  @@map("indicators")
}

model ChecklistItem {
  id            String    @id @default(cuid())
  activityId    String
  activity      Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  label         String
  responsibleId String
  responsible   User      @relation("ChecklistResponsible", fields: [responsibleId], references: [id])
  dueDate       DateTime?
  isMandatory   Boolean   @default(true)
  progress      Float     @default(0)
  observations  String?
  isValidated   Boolean   @default(false)
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  documents Document[]

  @@index([activityId])
  @@map("checklist_items")
}

model Validation {
  id          String             @id @default(cuid())
  activityId  String
  activity    Activity           @relation(fields: [activityId], references: [id])
  step        ValidationStep
  decision    ValidationDecision @default(EN_ATTENTE)
  validatorId String
  comment     String?
  createdAt   DateTime           @default(now())

  @@index([activityId])
  @@map("validations")
}

model Budget {
  id            String   @id @default(cuid())
  activityId    String
  activity      Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  planned       Decimal  @db.Decimal(14, 2)
  committed     Decimal  @default(0) @db.Decimal(14, 2)
  disbursed     Decimal  @default(0) @db.Decimal(14, 2)
  executed      Decimal  @default(0) @db.Decimal(14, 2)
  fundingSource String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([activityId])
  @@map("budgets")
}

model Document {
  id              String         @id @default(cuid())
  activityId      String?
  activity        Activity?      @relation(fields: [activityId], references: [id])
  checklistItemId String?
  checklistItem   ChecklistItem? @relation(fields: [checklistItemId], references: [id])
  type            String
  storageKey      String
  fileName        String
  fileSize        Int?
  mimeType        String?
  uploadedById    String
  createdAt       DateTime       @default(now())

  @@index([activityId])
  @@map("documents")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("AuditLogUser", fields: [userId], references: [id], onDelete: Cascade)
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// ==================== MODULES ADDITIONNELS ====================

// MODULE PARTICIPANTS
model Participant {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activityId     String
  activity       Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  phone       String
  paymentMode String // "WAVE" | "ORANGE_MONEY"
  amount      Float

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([phone, activityId])
  @@index([organizationId])
  @@index([activityId])
  @@map("participants")
}

// MODULE CAPITALISATION
model CapitalizationRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type       String // "BONNE_PRATIQUE" | "RECIT_CHANGEMENT" | "GUIDE"
  title      String
  context    String @db.Text
  challenges String @db.Text
  solutions  String @db.Text
  results    String @db.Text
  lessons    String @db.Text

  tags   String[]
  status String   @default("BROUILLON") // "BROUILLON" | "PUBLIE"

  authorId String
  author   User   @relation("CapitalizationAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media Media[]

  @@index([organizationId])
  @@index([authorId])
  @@map("capitalization_records")
}

model Media {
  id               String               @id @default(cuid())
  capitalizationId String
  capitalization   CapitalizationRecord @relation(fields: [capitalizationId], references: [id], onDelete: Cascade)

  type     String // "PHOTO" | "VIDEO" | "DOCUMENT"
  filename String
  url      String // Backblaze B2
  size     Int

  uploadedAt DateTime @default(now())

  @@index([capitalizationId])
  @@map("media")
}

// MODULE RECOMMANDATIONS
model Recommendation {
  id   String @id @default(cuid())
  code String @unique

  // Identification
  title       String
  description String @db.Text

  // Source
  source            RecommendationSource
  sourceReference   String?
  sourceDocumentUrl String?

  // Rattachements
  actionPlanId   String?
  actionPlan     ActionPlan?  @relation(fields: [actionPlanId], references: [id])
  activityId     String?
  activity       Activity?    @relation(fields: [activityId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Dates
  issuedAt    DateTime
  dueDate     DateTime
  completedAt DateTime?
  validatedAt DateTime?

  // Acteurs
  issuerId       String?
  issuer         User?   @relation("RecommendationIssuer", fields: [issuerId], references: [id])
  issuerExternal String?

  responsibleId String
  responsible   User   @relation("RecommendationResponsible", fields: [responsibleId], references: [id])

  validatorId String?
  validator   User?   @relation("RecommendationValidator", fields: [validatorId], references: [id])

  createdById String
  createdBy   User   @relation("RecommendationCreator", fields: [createdById], references: [id])

  // Contributeurs
  contributors RecommendationContributor[]

  // Suivi
  priority RecommendationPriority
  status   RecommendationStatus   @default(NON_DEMARREE)
  progress Int                    @default(0)

  // Actions et preuves
  actions   RecommendationAction[]
  evidences RecommendationEvidence[]
  comments  RecommendationComment[]

  // Gestion des retards/suspensions
  suspendedReason String?   @db.Text
  suspendedAt     DateTime?
  suspendedBy     String?

  reopenedReason String?   @db.Text
  reopenedAt     DateTime?
  reopenedBy     String?

  // Historique
  history RecommendationHistory[]

  // Métadonnées
  isRecurrent    Boolean @default(false)
  recurrenceNote String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([actionPlanId])
  @@index([activityId])
  @@index([responsibleId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([source])
  @@map("recommendations")
}

model RecommendationContributor {
  id               String         @id @default(cuid())
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  role             String?
  createdAt        DateTime       @default(now())

  @@unique([recommendationId, userId])
  @@index([recommendationId])
  @@index([userId])
  @@map("recommendation_contributors")
}

model RecommendationAction {
  id               String         @id @default(cuid())
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  title         String
  description   String?   @db.Text
  dueDate       DateTime?
  completedAt   DateTime?
  responsibleId String?
  responsible   User?     @relation(fields: [responsibleId], references: [id])

  status String @default("NON_DEMARREE")
  order  Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recommendationId])
  @@index([responsibleId])
  @@map("recommendation_actions")
}

model RecommendationEvidence {
  id               String         @id @default(cuid())
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  fileName    String
  fileUrl     String
  fileSize    Int
  mimeType    String
  description String?

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([recommendationId])
  @@index([uploadedById])
  @@map("recommendation_evidences")
}

model RecommendationComment {
  id               String         @id @default(cuid())
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  content     String  @db.Text
  isImportant Boolean @default(false)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recommendationId])
  @@index([authorId])
  @@map("recommendation_comments")
}

model RecommendationHistory {
  id               String         @id @default(cuid())
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  action   String
  field    String?
  oldValue String? @db.Text
  newValue String? @db.Text
  comment  String? @db.Text

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([recommendationId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("recommendation_history")
}

// MODULE HELP ARTICLES
model HelpArticle {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  page           String
  title          String
  content        String        @db.Text
  order          Int           @default(0)
  status         String        @default("DRAFT")
  authorId       String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([page])
  @@map("help_articles")
}

// MODULE PLANIFICATION
model AnnualWorkPlan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  year       Int
  title      String
  objectives Json // Structure flexible

  status      String    @default("BROUILLON") // "BROUILLON" | "VALIDE"
  validatedBy String?
  validatedAt DateTime?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([year])
  @@map("annual_work_plans")
}

model ResultsMatrix {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  data Json // Objectifs → Résultats → Indicateurs

  updatedAt DateTime @updatedAt

  @@map("results_matrices")
}
