# Copier ce fichier en .env.local et remplir les valeurs

# URL de l'API vue par le navigateur. « /api » (recommandé) passe par le proxy Next.js :
# même origine, cookies httpOnly sans configuration cross-domain.
NEXT_PUBLIC_API_URL=/api
# Backend vers lequel le proxy relaie /api
BACKEND_URL=http://localhost:3000
# Origine du backend pour le WebSocket de la messagerie
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Suivi des erreurs (Sentry)
NEXT_PUBLIC_SENTRY_DSN_FRONTEND=""
# Optionnel, pour envoyer les source maps en production
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
